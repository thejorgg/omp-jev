{
	"name": "omp-jev",
	"version": "0.1.1",
	"description": "TypeSafe Jev decision routing and configurable rules for Oh My Pi",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"omp-package",
		"pi-package",
		"typesafe",
		"jev"
	],
	"omp": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"files": [
		"src",
		"agents",
		"examples",
		"bin"
	],
	"scripts": {
		"test": "bun test",
		"check": "tsc --noEmit",
		"format": "biome format --write src bin test examples package.json tsconfig.json",
		"config": "bun bin/omp-jev.ts config"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-agent-core": ">=18.2.3",
		"@oh-my-pi/pi-ai": ">=18.2.3",
		"@oh-my-pi/pi-catalog": ">=18.2.3",
		"@oh-my-pi/pi-coding-agent": ">=18.2.3",
		"@oh-my-pi/pi-tui": ">=18.2.3",
		"@oh-my-pi/pi-natives": ">=18.2.3"
	},
	"peerDependenciesMeta": {
		"@oh-my-pi/pi-coding-agent": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@oh-my-pi/pi-coding-agent": "18.2.3",
		"@types/bun": "^1.3.14",
		"typescript": "^5.9.3"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"bin": {
		"omp-jev": "./bin/omp-jev.ts"
	}
}
