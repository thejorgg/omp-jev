{
	"name": "omp-jev",
	"version": "0.1.0",
	"description": "TypeSafe Jev decision routing and configurable rules for Oh My Pi",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"omp-package",
		"pi-package",
		"typesafe",
		"jev"
	],
	"omp": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"files": [
		"src",
		"agents",
		"examples"
	],
	"scripts": {
		"test": "bun test",
		"check": "tsc --noEmit",
		"format": "biome format --write src test examples package.json tsconfig.json"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": ">=18.2.3"
	},
	"peerDependenciesMeta": {
		"@oh-my-pi/pi-coding-agent": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@oh-my-pi/pi-coding-agent": "18.2.3",
		"@types/bun": "^1.3.14",
		"typescript": "^5.9.3"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
